# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MongoDB Atlas connection string. Use a dedicated database name, e.g. /fantasyfantasy-dev
MONGODB_URI=
# Connections per running API instance (default 10; use 5 on Vercel, where many instances can run at once)
MONGODB_MAX_POOL_SIZE=10

# Auth0 API settings (Applications > APIs in the Auth0 dashboard)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8080

# Reverse proxies in front of the API: 0 locally, usually 1 on a hosting platform
TRUST_PROXY_HOPS=0
